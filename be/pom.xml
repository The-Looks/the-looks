<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/>
	</parent>

	<groupId>vn.thelooks</groupId>
	<artifactId>the-looks-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>the-looks-backend</name>
	<description>THE LOOKS - backend microservices</description>

	<modules>
		<module>packages/contracts</module>
		<module>packages/observability</module>
		<module>packages/security</module>
		<module>services/auth-service</module>
		<module>services/wardrobe-service</module>
		<module>services/outfit-service</module>
		<module>services/voting-service</module>
	</modules>

	<properties>
		<java.version>25</java.version>
		<archunit.version>1.4.1</archunit.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>vn.thelooks</groupId>
				<artifactId>contracts</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>vn.thelooks</groupId>
				<artifactId>observability</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>vn.thelooks</groupId>
				<artifactId>security</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.tngtech.archunit</groupId>
				<artifactId>archunit-junit5</artifactId>
				<version>${archunit.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
</project>

# Service nào giả lập bằng MSW khi chạy `npm run dev` (theo đúng contract trong be/packages/contracts).
# Khi service thật đã chạy được thì bỏ tên nó khỏi danh sách. Để trống = gọi toàn bộ backend thật qua Vite proxy.
VITE_MOCK_SERVICES=auth,wardrobe,outfit,voting,billing
VITE_GOOGLE_ORIGIN=http://localhost:5173

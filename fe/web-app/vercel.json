{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/public/auth/:path*", "destination": "https://BACKEND_HOST:8081/api/public/auth/:path*" },
    { "source": "/api/app/me", "destination": "https://BACKEND_HOST:8081/api/app/me" },
    { "source": "/api/app/wardrobe/:path*", "destination": "https://BACKEND_HOST:8082/api/app/wardrobe/:path*" },
    { "source": "/api/app/outfits/:path*", "destination": "https://BACKEND_HOST:8083/api/app/outfits/:path*" },
    { "source": "/api/app/outfits", "destination": "https://BACKEND_HOST:8083/api/app/outfits" },
    { "source": "/api/app/polls/:path*", "destination": "https://BACKEND_HOST:8084/api/app/polls/:path*" },
    { "source": "/api/app/polls", "destination": "https://BACKEND_HOST:8084/api/app/polls" },
    { "source": "/api/public/polls/:path*", "destination": "https://BACKEND_HOST:8084/api/public/polls/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
